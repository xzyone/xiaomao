# XiaoMao production environment example
NODE_ENV=production
PORT=3001
TRUST_PROXY=1

# External MySQL / 1Panel MySQL
DB_HOST=your_1panel_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=change_me
DB_NAME=xiaomaodb

# Authentication
JWT_SECRET=change_to_a_long_random_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Public URL and CORS
API_BASE_URL=https://mao.kdgq.com
LOCAL_BASE_URL=https://mao.kdgq.com
CORS_ORIGIN=https://mao.kdgq.com

# Local media storage
IMAGE_UPLOAD_STRATEGY=local
VIDEO_UPLOAD_STRATEGY=local
IMAGE_LOCAL_UPLOAD_DIR=uploads/images
VIDEO_LOCAL_UPLOAD_DIR=uploads/videos
IMAGE_MAX_SIZE=10mb
VIDEO_MAX_SIZE=100mb

# Host-side persistent upload directory used by docker-compose
XIAOMAO_UPLOAD_DIR=/vol2/1000/web/data/xiaomao/uploads

# Optional email service
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=小毛毛

# IP location APIs
IP_LOCATION_PRIMARY_API=https://api.pearktrue.cn/api/ip/details
IP_LOCATION_PRIMARY_TIMEOUT=10000
IP_LOCATION_BACKUP_API=https://api.pearktrue.cn/api/ip/high
IP_LOCATION_BACKUP_TIMEOUT=5000
