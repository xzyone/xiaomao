<view wx:if="{{pageAllowed}}" class="page-shell profile-page">
  <view wx:if="{{user}}" class="profile-card">
    <image class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
    <text class="nickname">{{user.nickname}}</text>
    <text class="account">毛毛号：{{user.user_id}}</text>
    <text class="bio">{{user.bio || '还没有个人简介'}}</text>
    <view class="stats-row">
      <view><text class="number">{{user.follow_count || 0}}</text><text class="stat-label">关注</text></view>
      <view><text class="number">{{user.fans_count || 0}}</text><text class="stat-label">粉丝</text></view>
      <view><text class="number">{{user.like_count || 0}}</text><text class="stat-label">获赞</text></view>
    </view>
    <button class="secondary-button" bindtap="logout">退出登录</button>
  </view>
  <view wx:elif="{{!loading}}" class="guest-card">
    <text class="guest-title">登录小毛毛</text>
    <button class="primary-button" bindtap="goLogin">去登录</button>
  </view>
  <bottom-nav current="profile" audit-mode-enabled="{{auditModeEnabled}}" />
</view>
