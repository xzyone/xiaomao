<view wx:if="{{pageAllowed}}" class="page-shell profile-page">
  <view wx:if="{{user}}" class="profile-card">
    <image class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
    <text class="nickname">{{user.nickname}}</text>
    <text class="account">{{ui.labels.profileAccountPrefix}}{{user.user_id}}</text>
    <text class="bio">{{user.bio || ui.labels.profileEmptyBio}}</text>
    <view class="stats-row">
      <view><text class="number">{{user.follow_count || 0}}</text><text class="stat-label">{{ui.labels.profileFollowing}}</text></view>
      <view><text class="number">{{user.fans_count || 0}}</text><text class="stat-label">{{ui.labels.profileFans}}</text></view>
      <view><text class="number">{{user.like_count || 0}}</text><text class="stat-label">{{ui.labels.profileLikes}}</text></view>
    </view>
    <button class="secondary-button" bindtap="logout">{{ui.labels.profileLogout}}</button>
  </view>
  <view wx:elif="{{!loading}}" class="guest-card">
    <text class="guest-title">{{ui.labels.profileGuestTitle}}</text>
    <button class="primary-button" bindtap="goLogin">{{ui.labels.profileGoLogin}}</button>
  </view>
  <bottom-nav current="profile" audit-mode-enabled="{{auditModeEnabled}}" labels="{{ui.labels}}" />
</view>
