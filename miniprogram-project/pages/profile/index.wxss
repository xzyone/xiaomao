.profile-page { padding: 70rpx 34rpx; }
.profile-card, .guest-card { display: flex; flex-direction: column; align-items: center; padding: 50rpx 34rpx; }
.profile-avatar { width: 150rpx; height: 150rpx; border-radius: 50%; background: #eee; }
.avatar-empty { display: flex; align-items: center; justify-content: center; background: #ff2442; color: #fff; font-size: 52rpx; font-weight: 800; }
.nickname { margin-top: 24rpx; font-size: 38rpx; font-weight: 800; }
.account, .bio { margin-top: 10rpx; color: #888; font-size: 24rpx; }
.bio { margin-top: 22rpx; text-align: center; line-height: 1.6; }
.stats-row { width: 100%; margin-top: 50rpx; padding: 30rpx 0; border-top: 1rpx solid #eee; border-bottom: 1rpx solid #eee; display: flex; justify-content: space-around; }
.stats-row view { text-align: center; }
.number { display: block; font-size: 32rpx; font-weight: 700; }
.stat-label { display: block; margin-top: 8rpx; color: #999; font-size: 22rpx; }
.secondary-button, .primary-button { width: 58%; margin: 50rpx auto 0; height: 82rpx; padding: 0; border-radius: 41rpx; font-size: 27rpx; display: flex; align-items: center; justify-content: center; line-height: 1; box-sizing: border-box; }
.secondary-button::after, .primary-button::after { border: none; }
.secondary-button { background: #f7f7f7; color: #555; }
.primary-button { background: #ff2442; color: #fff; }
.guest-card { padding-top: 180rpx; }
.guest-title { font-size: 40rpx; font-weight: 800; }
