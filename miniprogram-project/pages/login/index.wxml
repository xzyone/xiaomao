<view wx:if="{{pageAllowed}}" class="login-page">
  <view class="login-brand">
    <image wx:if="{{logoUrl && !logoLoadFailed}}" class="brand-logo" src="{{logoUrl}}" mode="aspectFill" binderror="onLogoError" />
    <view wx:else class="brand-logo brand-logo-fallback">毛</view>
    <text class="logo-text">{{ui.labels.loginBrand}}</text>
    <text class="subtitle">{{ui.labels.loginSubtitle}}</text>
  </view>
  <view class="form-card">
    <text class="label">{{ui.labels.loginAccount}}</text>
    <input class="input" value="{{userId}}" placeholder="{{ui.placeholders.loginAccount}}" bindinput="onUserIdInput" />
    <text class="label second">{{ui.labels.loginPassword}}</text>
    <input class="input" value="{{password}}" password placeholder="{{ui.placeholders.loginPassword}}" bindinput="onPasswordInput" />
    <button class="login-button" loading="{{submitting}}" bindtap="submit">{{ui.labels.loginSubmit}}</button>
    <text class="hint">{{ui.labels.loginHint}}</text>
  </view>
</view>
