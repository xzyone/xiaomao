.home-page { padding-left: 22rpx; padding-right: 22rpx; }
.brand-row { padding: 22rpx 4rpx 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.brand-main { display: flex; align-items: baseline; gap: 16rpx; min-width: 0; }
.brand-title { font-size: 40rpx; font-weight: 800; letter-spacing: -1rpx; color: #222; white-space: nowrap; }
.brand-subtitle { font-size: 22rpx; color: #999; white-space: nowrap; }
.readonly-pill { padding: 8rpx 16rpx; border-radius: 999rpx; background: #f7f7f7; color: #858585; font-size: 20rpx; flex-shrink: 0; }
.channel-scroll { width: 100%; white-space: nowrap; margin-bottom: 14rpx; }
.channel-list { display: flex; align-items: center; gap: 34rpx; min-width: max-content; padding: 8rpx 4rpx 16rpx; }
.channel-item { color: #858585; font-size: 27rpx; line-height: 44rpx; position: relative; }
.channel-item.active { color: #222; font-weight: 700; }
.channel-item.active::after { content: ''; position: absolute; left: 50%; transform: translateX(-50%); bottom: -5rpx; width: 28rpx; height: 5rpx; border-radius: 4rpx; background: #ff2442; }
.waterfall { display: flex; align-items: flex-start; gap: 18rpx; }
.column { width: calc((100% - 18rpx) / 2); }
.load-state, .empty-state { padding: 36rpx 0; text-align: center; color: #aaa; font-size: 24rpx; }
.empty-state { padding-top: 180rpx; }
