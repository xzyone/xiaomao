<view class="page-shell home-page">
  <view class="brand-row">
    <view class="brand-main">
      <text class="brand-title">小毛毛</text>
      <text class="brand-subtitle">毛毛的快乐狗生</text>
    </view>
  </view>
  <scroll-view class="channel-scroll" scroll-x enable-flex show-scrollbar="false">
    <view class="channel-list">
      <view class="channel-item {{currentCategory === 'recommend' ? 'active' : ''}}" data-category="recommend" bindtap="changeCategory">推荐</view>
      <view wx:for="{{categories}}" wx:key="id" class="channel-item {{currentCategory == item.id ? 'active' : ''}}" data-category="{{item.id}}" bindtap="changeCategory">{{item.name}}</view>
    </view>
  </scroll-view>
  <view class="waterfall">
    <view class="column"><post-card wx:for="{{leftPosts}}" wx:key="id" post="{{item}}" /></view>
    <view class="column"><post-card wx:for="{{rightPosts}}" wx:key="id" post="{{item}}" /></view>
  </view>
  <view wx:if="{{loading}}" class="load-state">加载中...</view>
  <view wx:elif="{{posts.length && !hasMore}}" class="load-state">已经到底啦</view>
  <view wx:elif="{{!posts.length && !loading}}" class="empty-state">还没有内容</view>
  <bottom-nav current="home" audit-mode-enabled="{{auditModeEnabled}}" />
</view>
