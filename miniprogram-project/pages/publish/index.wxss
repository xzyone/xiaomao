.publish-page { min-height: 100vh; padding: 28rpx 28rpx 60rpx; background: #fff; }
.type-tabs { display: flex; gap: 40rpx; margin-bottom: 28rpx; }
.type-tab { padding: 10rpx 4rpx; color: #999; font-size: 28rpx; position: relative; }
.type-tab.active { color: #222; font-weight: 800; }
.type-tab.active::after { content: ''; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 32rpx; height: 5rpx; border-radius: 4rpx; background: #ff2442; }
.media-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.media-item, .add-media { position: relative; aspect-ratio: 1; border-radius: 12rpx; overflow: hidden; }
.media-image { width: 100%; height: 100%; }
.add-media, .add-video { background: #f7f7f7; color: #999; display: flex; flex-direction: column; gap: 8rpx; align-items: center; justify-content: center; font-size: 22rpx; }
.plus { color: #777; font-size: 54rpx; line-height: 1; font-weight: 200; }
.remove { position: absolute; right: 8rpx; top: 8rpx; width: 42rpx; height: 42rpx; border-radius: 21rpx; background: rgba(0,0,0,.55); color: #fff; text-align: center; line-height: 39rpx; font-size: 30rpx; }
.video-zone { width: 100%; }
.add-video { height: 390rpx; border-radius: 14rpx; }
.video-preview-wrap { position: relative; }
.video-preview { width: 100%; height: 480rpx; border-radius: 14rpx; background: #111; }
.video-remove { z-index: 2; }
.editor-card { margin-top: 34rpx; }
.title-input { height: 84rpx; border-bottom: 1rpx solid #eee; font-size: 34rpx; font-weight: 700; }
.content-input { width: 100%; min-height: 250rpx; padding: 26rpx 0; line-height: 1.7; font-size: 28rpx; }
.setting-list { margin-top: 18rpx; border-top: 1rpx solid #eee; }
.setting-row { min-height: 94rpx; border-bottom: 1rpx solid #eee; display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; }
.setting-value { color: #999; }
.tags-row { gap: 20rpx; }
.tags-input { flex: 1; text-align: right; font-size: 25rpx; }
.publish-button { margin-top: 48rpx; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; background: #ff2442; color: #fff; font-size: 29rpx; font-weight: 700; }
