.detail-page { min-height: 100vh; padding-bottom: 150rpx; background: #fff; }
.post-author-header { min-height: 92rpx; padding: 18rpx 28rpx; display: flex; align-items: center; gap: 16rpx; box-sizing: border-box; background: #fff; }
.author-copy { min-width: 0; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.nickname { display: block; font-size: 27rpx; font-weight: 650; color: #222; }
.author-location { display: block; margin-top: 3rpx; color: #999; font-size: 19rpx; }
.media-stage { position: relative; width: 100%; background: #f3f3f3; transition: height 0.18s ease; overflow: hidden; }
.media-swiper { width: 100%; background: #f3f3f3; transition: height 0.18s ease; }
.detail-image { width: 100%; height: 100%; background: #f3f3f3; }
.detail-video { width: 100%; height: 760rpx; background: #111; }
.original-image-button { position: absolute; z-index: 5; top: 18rpx; right: 18rpx; width: 76rpx; min-width: 76rpx; max-width: 76rpx; height: 42rpx; margin: 0; padding: 0; border-radius: 21rpx; background: rgba(0, 0, 0, 0.48); color: #fff; font-size: 20rpx; font-weight: 500; line-height: 1; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.original-image-button::after { border: none; }
.detail-content { padding: 24rpx 28rpx 28rpx; border-bottom: 1rpx solid #eee; }
.title { display: block; font-size: 34rpx; line-height: 1.4; font-weight: 800; color: #222; }
.content { display: block; margin-top: 14rpx; white-space: pre-wrap; font-size: 27rpx; line-height: 1.65; color: #3d3d3d; }
.tag-row { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag { color: #365d91; font-size: 24rpx; }
.date { display: block; margin-top: 20rpx; color: #aaa; font-size: 21rpx; }
.comments-section { padding: 32rpx 28rpx 30rpx; }
.section-title { display: block; margin-bottom: 22rpx; font-size: 29rpx; font-weight: 700; }
.comment-item { display: flex; gap: 18rpx; padding: 18rpx 0 28rpx; }
.comment-avatar { width: 66rpx; height: 66rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.comment-body { flex: 1; min-width: 0; }
.comment-user { display: block; color: #858585; font-size: 23rpx; }
.comment-content { display: block; margin-top: 8rpx; font-size: 27rpx; line-height: 1.6; color: #333; }
.comment-meta { display: block; margin-top: 8rpx; color: #aaa; font-size: 20rpx; }
.no-comments, .loading-page { padding: 90rpx 0; text-align: center; color: #aaa; }
.comment-bar { position: fixed; z-index: 50; left: 0; right: 0; bottom: 0; min-height: 108rpx; padding: 16rpx 24rpx; display: flex; gap: 16rpx; align-items: center; background: #fff; border-top: 1rpx solid #eee; }
.comment-input { flex: 1; height: 70rpx; padding: 0 24rpx; border-radius: 35rpx; background: #f7f7f7; font-size: 26rpx; }
.send-button { width: 120rpx; height: 68rpx; margin: 0; padding: 0; border-radius: 34rpx; background: #ff2442; color: #fff; font-size: 25rpx; display: flex; align-items: center; justify-content: center; line-height: 1; box-sizing: border-box; }
.send-button::after { border: none; }
