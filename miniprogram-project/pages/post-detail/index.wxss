.detail-page { min-height: 100vh; padding-bottom: 150rpx; background: #fff; }
.media-stage { position: relative; width: 100%; height: 520rpx; background: #f7f7f7; }
.media-swiper { width: 100%; height: 520rpx; background: #f7f7f7; }
.detail-image, .detail-video { width: 100%; height: 100%; background: #f7f7f7; }
.detail-video { height: 520rpx; }
.original-image-button { position: absolute; z-index: 5; left: 50%; bottom: 22rpx; min-width: 126rpx; height: 54rpx; margin: 0; padding: 0 22rpx; transform: translateX(-50%); border-radius: 27rpx; background: rgba(0, 0, 0, 0.58); color: #fff; font-size: 22rpx; font-weight: 500; line-height: 1; display: flex; align-items: center; justify-content: center; }
.original-image-button::after { border: none; }
.detail-content { padding: 30rpx 30rpx 26rpx; border-bottom: 1rpx solid #eee; }
.author-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.author-main { display: flex; align-items: center; gap: 18rpx; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #eee; }
.avatar-empty { background: #eee; }
.nickname { display: block; font-size: 27rpx; font-weight: 600; }
.author-location { display: block; margin-top: 5rpx; color: #999; font-size: 20rpx; }
.title { display: block; font-size: 36rpx; line-height: 1.45; font-weight: 800; color: #222; }
.content { display: block; margin-top: 22rpx; white-space: pre-wrap; font-size: 29rpx; line-height: 1.75; color: #444; }
.tag-row { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { color: #365d91; font-size: 25rpx; }
.date { display: block; margin-top: 28rpx; color: #aaa; font-size: 22rpx; }
.comments-section { padding: 30rpx; }
.section-title { display: block; margin-bottom: 24rpx; font-size: 30rpx; font-weight: 700; }
.comment-item { display: flex; gap: 18rpx; padding: 18rpx 0 28rpx; }
.comment-avatar { width: 66rpx; height: 66rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.comment-body { flex: 1; min-width: 0; }
.comment-user { display: block; color: #858585; font-size: 23rpx; }
.comment-content { display: block; margin-top: 8rpx; font-size: 27rpx; line-height: 1.6; color: #333; }
.comment-meta { display: block; margin-top: 8rpx; color: #aaa; font-size: 20rpx; }
.no-comments, .loading-page { padding: 100rpx 0; text-align: center; color: #aaa; }
.comment-bar { position: fixed; z-index: 50; left: 0; right: 0; bottom: 0; min-height: 108rpx; padding: 16rpx 24rpx; display: flex; gap: 16rpx; align-items: center; background: #fff; border-top: 1rpx solid #eee; }
.comment-input { flex: 1; height: 70rpx; padding: 0 24rpx; border-radius: 35rpx; background: #f7f7f7; font-size: 26rpx; }
.send-button { width: 120rpx; height: 68rpx; margin: 0; padding: 0; border-radius: 34rpx; background: #ff2442; color: #fff; font-size: 25rpx; display: flex; align-items: center; justify-content: center; line-height: 1; box-sizing: border-box; }
.send-button::after { border: none; }
