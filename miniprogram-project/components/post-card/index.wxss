.post-card { width: 100%; overflow: hidden; border-radius: 14rpx; background: #fff; margin-bottom: 22rpx; }
.media-box { position: relative; overflow: hidden; border-radius: 14rpx; background: #f7f7f7; min-height: 230rpx; }
.cover { width: 100%; display: block; }
.media-placeholder { height: 300rpx; display: flex; align-items: center; justify-content: center; color: #bbb; font-size: 24rpx; }
.video-badge { position: absolute; right: 14rpx; top: 14rpx; width: 46rpx; height: 46rpx; border-radius: 23rpx; background: rgba(0,0,0,.45); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20rpx; }
.post-body { padding: 14rpx 6rpx 4rpx; }
.post-title { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: #333; font-size: 28rpx; font-weight: 600; line-height: 1.45; }
.post-meta { margin-top: 14rpx; display: flex; align-items: center; justify-content: space-between; color: #858585; font-size: 22rpx; }
.author-wrap, .like-wrap { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.avatar { width: 36rpx; height: 36rpx; border-radius: 50%; background: #eee; }
.avatar-empty { background: #e7e7e7; }
.author { max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.like-wrap { flex-shrink: 0; }
