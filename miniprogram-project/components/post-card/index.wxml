<view class="post-card" bindtap="openPost">
  <view class="media-box">
    <image wx:if="{{post.images && post.images.length}}" class="cover" src="{{post.thumbnail_image || (post.thumbnail_images && post.thumbnail_images[0]) || post.images[0]}}" mode="widthFix" lazy-load />
    <view wx:else class="media-placeholder">{{post.type === 2 ? labels.postVideo : labels.homeBrand}}</view>
    <view wx:if="{{post.type === 2}}" class="video-badge">▶</view>
  </view>
  <view class="post-body">
    <text class="post-title">{{post.title}}</text>
    <view class="post-meta">
      <view class="author-wrap">
        <image class="avatar" src="{{avatarFailed ? '/assets/avatar.png' : (post.user_avatar || '/assets/avatar.png')}}" mode="aspectFill" lazy-load binderror="onAvatarError" />
        <text class="author">{{post.nickname || labels.anonymousUser}}</text>
      </view>
      <view class="like-wrap"><text>♡</text><text>{{post.like_count || 0}}</text></view>
    </view>
  </view>
</view>
